# pkg-config template for the C library. install.sh fills in the prefix and the library version
# (tpml_version() reports the version) and writes the result as tpt-ml-proven.pc.
# Afterwards `pkg-config --cflags --libs tpt-ml-proven` works.

prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: tpt-ml-proven
Description: Classical machine learning with contract-checked algorithms (C ABI)
Version: @VERSION@
Libs: -L${libdir} -ltpt_ml_proven
Cflags: -I${includedir}
