"""Type stubs for the compiled tpt_ml_proven extension.

Inputs are 2-D arrays of numbers: anything NumPy can view as a float matrix, such as a
`numpy.ndarray` or a list of rows. Targets are sequences of numbers, one per row.
"""

from typing import List, Optional, Sequence, Union

ArrayLike = Union[Sequence[Sequence[float]], object]
Vector = Union[Sequence[float], object]

class KMeans:
    def __init__(
        self,
        n_clusters: int,
        *,
        max_iter: int = 300,
        tol: float = 1e-4,
        init: str = "k-means++",
        seed: int = 0,
        threads: int = 1,
    ) -> None: ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(data: bytes) -> "KMeans": ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> "KMeans": ...
    def __reduce__(self) -> tuple: ...
    def fit(self, X: ArrayLike) -> "KMeans": ...
    def predict(self, X: ArrayLike) -> List[int]: ...
    def transform(self, X: ArrayLike) -> List[List[float]]: ...
    def fit_transform(self, X: ArrayLike) -> List[List[float]]: ...
    @property
    def labels_(self) -> List[int]: ...
    @property
    def cluster_centers_(self) -> List[List[float]]: ...
    @property
    def inertia_(self) -> float: ...
    @property
    def n_iter_(self) -> int: ...
    @property
    def converged_(self) -> bool: ...

