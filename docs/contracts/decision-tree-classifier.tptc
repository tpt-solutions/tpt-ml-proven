# Classification tree contract, for DecisionTreeClassifier (crates/tpt-ml-proven-trees/src/classifier.rs).
# Format and verification rules: docs/contracts/README.md

contract classifier
source crates/tpt-ml-proven-trees/src/classifier.rs

requires[rows_positive]: X.rows >= 1
requires[max_depth_positive]: max_depth >= 1
requires[min_samples_leaf_positive]: min_samples_leaf >= 1

# The leaves hold every training row exactly once. Uninterpreted, so checked at runtime.
ensures[leaves_partition_rows]: leaf_total(tree) == X.rows

# No path from the root is longer than max_depth.
ensures[depth_bounded]: depth_of(tree) <= max_depth

# Every leaf predicts a class seen in training, so predictions never invent a label.
ensures[predicts_training_class]: leaves_in_classes(tree, classes) == 1
